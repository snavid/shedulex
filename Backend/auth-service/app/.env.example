# Local non-Docker dev only — run postgres/redis via docker-compose.dev-ports.yml first
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://shedulex:shedulex_secret@localhost:5543/auth_db
REDIS_URL=redis://localhost:6490/0
JWT_SECRET_KEY=jwt-secret-change-me
JWT_ISSUER=shedulex
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173
# In Docker use http://audit-service:5008; localhost only when running this service on the host
AUDIT_SERVICE_URL=http://localhost:5008
