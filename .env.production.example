# Production environment template for VPS deployment.
# Copy to .env on the server:  cp .env.production.example .env
# Paste secrets from your local backup env.backup — keep JWT_SECRET_KEY identical
# so existing sessions remain valid after migration.

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=shedulex
POSTGRES_PASSWORD=CHANGE_ME_SAME_AS_LOCAL_OR_UPDATE_DUMP
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB=auth_db
TIMETABLE_DB=timetable_db
ADJUSTMENT_DB=adjustment_db
NOTIFICATION_DB=notification_db
CALENDAR_DB=calendar_db
DOCUMENT_DB=document_db
ANALYTICS_DB=analytics_db
AUDIT_DB=audit_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT (must match local .env for migrated data) ───────────────────────────
JWT_ISSUER=shedulex
JWT_SECRET_KEY=CHANGE_ME_COPY_FROM_LOCAL_ENV
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
INTERNAL_SERVICE_KEY=CHANGE_ME_COPY_FROM_LOCAL_ENV

# ─── Public URLs ─────────────────────────────────────────────────────────────
DOCUMENT_PUBLIC_BASE_URL=https://shedulex.hudumatech.com
FRONTEND_URL=http://localhost:5173

EXPORT_CACHE_TTL_SECONDS=300
EXPORT_SHARE_TOKEN_MAX_HOURS=168
DOCUMENT_SHARE_SECRET=CHANGE_ME_COPY_FROM_LOCAL_ENV
DOCUMENT_SHARE_SALT=shedulex-document-share

# ─── Email ───────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@shedulex.ac

# ─── Beem SMS ────────────────────────────────────────────────────────────────
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key
BEEM_SENDER_NAME=HudumaTech
DEFAULT_SMS_PHONE=+255749300606

TIMETABLE_NOTIFY_ENABLED=true
TIMETABLE_EVENT_DEBOUNCE_SECONDS=60

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ─── Internal service URLs (Docker network — do not change) ─────────────────
AUTH_SERVICE_URL=http://auth-service:5001
TIMETABLE_SERVICE_URL=http://timetable-engine:5002
ADJUSTMENT_SERVICE_URL=http://adjustment-engine:5003
NOTIFICATION_SERVICE_URL=http://notification-service:5004
CALENDAR_SERVICE_URL=http://calendar-service:5005
DOCUMENT_SERVICE_URL=http://document-service:5006
ANALYTICS_SERVICE_URL=http://analytics-service:5007
AUDIT_SERVICE_URL=http://audit-service:5008

# ─── App ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
