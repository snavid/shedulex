# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=shedulex
POSTGRES_PASSWORD=shedulex_secret
POSTGRES_HOST=postgres
# Host port published by Docker Compose (5543 -> 5432 in container). Use localhost:5543 from your machine.
POSTGRES_PORT=5543

# Per-service databases (created by init script)
AUTH_DB=auth_db
TIMETABLE_DB=timetable_db
ADJUSTMENT_DB=adjustment_db
NOTIFICATION_DB=notification_db
CALENDAR_DB=calendar_db
DOCUMENT_DB=document_db
ANALYTICS_DB=analytics_db
AUDIT_DB=audit_db

# ─── Redis ───────────────────────────────────────────────────────────────────
# In Docker Compose, always use hostname `redis` and container port 6379 (Compose overrides this in yml).
# From your machine only: redis://localhost:6490/0 (host maps 6490 -> 6379).
REDIS_URL=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Issuer (iss) on tokens; must match Kong consumer jwt_secrets.key (docker-compose kong configs).
JWT_ISSUER=shedulex
# Must match Kong HS256 jwt_secrets.secret. Avoid ", :, and newlines so the merged YAML stays valid.
JWT_SECRET_KEY=1db71fc3826f11d2a0f7fb87b7ba66fbb6d2bc8e26a0e2b04675
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
INTERNAL_SERVICE_KEY=6aeff8894533f01bd43e67f8c9101517

# Document export platform
DOCUMENT_PUBLIC_BASE_URL=http://localhost:8000
EXPORT_CACHE_TTL_SECONDS=300
EXPORT_SHARE_TOKEN_MAX_HOURS=168
DOCUMENT_SHARE_SECRET=513f1ae08aaed94810d87b50e39c077851ca44b2ad7362bbba60
DOCUMENT_SHARE_SALT=shedulex-document-share

# ─── Email ───────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@shedulex.ac

# ─── Beem SMS Africa ─────────────────────────────────────────────────────────
# Get API key + secret from https://beem.africa dashboard (paste plain text values)
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key
# Registered sender ID from your Beem dashboard (max 11 chars, e.g. HudumaTech)
BEEM_SENDER_NAME=HudumaTech
# Used when a recipient has no phone number on file (dev/testing fallback)
DEFAULT_SMS_PHONE=+255749300606

# ─── Timetable SMS broadcasts ────────────────────────────────────────────────
TIMETABLE_NOTIFY_ENABLED=true
TIMETABLE_EVENT_DEBOUNCE_SECONDS=60

# ─── Calendar event SMS ───────────────────────────────────────────────────────
CALENDAR_SERVICE_URL=http://calendar-service:5005

# ─── OpenAI (for LangGraph AI assistant) ─────────────────────────────────────
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini

# ─── Services (internal URLs) ────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:5001
TIMETABLE_SERVICE_URL=http://timetable-engine:5002
ADJUSTMENT_SERVICE_URL=http://adjustment-engine:5003
NOTIFICATION_SERVICE_URL=http://notification-service:5004
CALENDAR_SERVICE_URL=http://calendar-service:5005
DOCUMENT_SERVICE_URL=http://document-service:5006
ANALYTICS_SERVICE_URL=http://analytics-service:5007
AUDIT_SERVICE_URL=http://audit-service:5008

# ─── App ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:5173
